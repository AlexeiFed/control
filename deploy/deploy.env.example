# Скопируй в deploy/deploy.env и заполни. Файл с секретами не коммить.
DEPLOY_HOST=85.209.9.29
DEPLOY_USER=root
REMOTE_DIR=/var/www/vityaz-erp
APP_USER=vityazerp
APP_PORT=3002
DOMAIN=vityaz-erp.ru
WWW_DOMAIN=www.vityaz-erp.ru
CERTBOT_EMAIL=you@example.com

# PostgreSQL (роль/БД создаёт bootstrap)
VITYAZ_ERP_DB_PASSWORD=

# Приложение (.env на сервере)
ERP_SESSION_SECRET=
ADMINISTRATOR_ROLE_PASSWORD=
PLANNER_ROLE_PASSWORD=
ACCOUNTANT_ROLE_PASSWORD=

# Первый администратор (data/users.json на сервере; каталог data/ не rsync’ится)
SEED_ADMIN_EMAIL=admin@vityaz-erp.ru
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Администратор
#
# После первого deploy (tsx снят npm prune): на сервере один раз:
#   sudo -u vityazerp bash -lc 'cd /var/www/vityaz-erp && npx --yes tsx@latest src/scripts/seed-admin.ts'
#
# Если на сервере Swap=0, при деплое создаётся /swapfile (размер MiB). Отключить автосwap: DEPLOY_ENSURE_SWAP=0
# DEPLOY_SWAP_MB=2048
# DEPLOY_ENSURE_SWAP=1
#
# Heap Node для `next build` (МБ). При SIGKILL на сборке — 512 или меньше NODE_OPTIONS.
# NEXT_NODE_MEMORY=768
#
# SSL (уже выдан на сервере; повтор при смене домена):
#   certbot --nginx -d vityaz-erp.ru -d www.vityaz-erp.ru --non-interactive --agree-tos -m "$CERTBOT_EMAIL" --redirect
